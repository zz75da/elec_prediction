# Copy this file to .env and fill in your own values.
# .env is gitignored — never commit real credentials.

# --- DagsHub (MLflow tracking + DVC remote, same pattern as rakuten_mlops_services) ---
DAGSHUB_USER=your-dagshub-username
DAGSHUB_TOKEN=your-dagshub-token
MLFLOW_TRACKING_URI=https://dagshub.com/<your-dagshub-username>/elec_prediction.mlflow
MLFLOW_TRACKING_USERNAME=your-dagshub-username
MLFLOW_TRACKING_PASSWORD=your-dagshub-token
MLFLOW_S3_ENDPOINT_URL=https://dagshub.com/api/v1/repo-buckets/s3/your-dagshub-username
MLFLOW_ARTIFACT_URI=s3://elec_prediction
MLFLOW_EXPERIMENT_NAME=elec_prediction

# --- Service URLs (internal docker-compose network) ---
TRAIN_API_URL=http://train-api:5010
PREDICT_API_URL=http://predict-api:5011

# --- Grafana ---
GF_SECURITY_ADMIN_PASSWORD=admin

# --- Misc ---
# Skip `dvc pull` inside containers if data/artifacts are already mounted locally
SKIP_DVC_PULL=1
